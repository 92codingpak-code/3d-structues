# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# asset pipeline
scripts/.venv
scripts/__pycache__/
# raw BodyParts3D STLs are large CC BY-SA binaries - see assets/BodyParts3D_data/README.md
/assets/BodyParts3D_data/*
!/assets/BodyParts3D_data/README.md
# public/models/ is generated by scripts/process_assets.py but IS committed:
# the deployed site serves the .glb files statically, so they have to be in
# the repo until the assets move to Supabase Storage. They are CC BY-SA
# derivatives - see public/models/LICENSE.md.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
